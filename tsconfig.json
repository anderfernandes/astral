{
  "include": ["**/*.ts", "**/*.tsx"],
  "compilerOptions": {
    "strict": true,
    "esModuleInterop": true,
    "jsx": "preserve",
    "jsxImportSource": "@solidjs/web",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "target": "ES2022",
    "allowJs": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "~components": ["./src/components/index.ts"],
      "~db": ["./src/db/index.server.ts"],
      "~utils/*": ["./src/utils/*"],
      "~repositories/MembershipTypeRepository": ["./src/repositories/MembershipTypeRepository.server.ts"],
      "~repositories/SaleRepository":["./src/repositories/SaleRepository.server.ts"],
      "~repositories/TokenRepository": ["./src/repositories/TokenRepository.server.ts"],
      "~repositories/UserRepository": ["./src/repositories/UserRepository.server.ts"],
    }
  }
}